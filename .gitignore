# ─── Monorepo root ───────────────────────────────────────────
# Per-workspace rules live in client/.gitignore and server/.gitignore.
# Only cross-cutting noise belongs here.

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.idea/
*.iml
*.ipr
*.iws
*.swp
.history/
# .vscode/ is intentionally tracked — it holds shared launch configs.

# Logs
*.log

# Local tooling / secrets
.env
.env.local
